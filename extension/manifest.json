{
  "manifest_version": 3,
  "name": "Slide Pulse Follower",
  "version": "1.3.5",
  "description": "Keeps Slide Pulse student phones in sync with the slide you are presenting in Google Slides.",
  "permissions": [
    "storage",
    "debugger"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/presentation/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Slide Pulse",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
