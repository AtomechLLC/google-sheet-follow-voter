{
  "name": "slide-pulse",
  "version": "0.1.0",
  "description": "Live, anonymous slide-by-slide feedback for Google Slides presentations. Students scan a QR code and tap Great / Didn't understand / I have a question.",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.0.0",
    "express": "^5.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "playwright": "^1.50.0"
  }
}
