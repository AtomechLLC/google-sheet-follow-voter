# Public URL students will reach (used for the QR code and the Google OAuth redirect).
BASE_URL=http://localhost:3000
PORT=3000

# Google OAuth client (Web application type). See README for setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string used to sign teacher cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Where the SQLite database and slide images are stored.
DATA_DIR=./data

# Set to 1 to enable "Try a demo deck" (placeholder slides, no Google needed).
DEMO_MODE=0

# Slide image size fetched from Google: SMALL (200px), MEDIUM (800px), LARGE (1600px)
THUMBNAIL_SIZE=MEDIUM

# --- Speaker-note translation (optional). Set ONE of these; the first present wins. ---
# Google Cloud Translation API key (enable "Cloud Translation API" in your project; needs billing enabled).
GOOGLE_TRANSLATE_API_KEY=
# DeepL API key (free tier keys end with ":fx"). No Hindi, Bengali or Urdu.
DEEPL_API_KEY=
# Anthropic API key to translate with Claude. Optional CLAUDE_MODEL (default claude-opus-5).
ANTHROPIC_API_KEY=
# Force a provider: google | deepl | claude | mock | none  (default: auto-detect from the keys above)
TRANSLATE_PROVIDER=
# Language your speaker notes are written in (default en)
NOTES_LANGUAGE=en
