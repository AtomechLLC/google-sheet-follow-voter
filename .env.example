# Public URL students will reach (used for the QR code and the Google OAuth redirect).
BASE_URL=http://localhost:3000
PORT=3000

# Google OAuth client (Web application type). See README for setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Random string used to sign teacher cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Where the SQLite database and slide images are stored.
DATA_DIR=./data

# Set to 1 to enable "Try a demo deck" (placeholder slides, no Google needed).
DEMO_MODE=0

# Slide image size fetched from Google: SMALL (200px), MEDIUM (800px), LARGE (1600px)
THUMBNAIL_SIZE=MEDIUM
